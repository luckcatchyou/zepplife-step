{
  "name": "zepp-life-step",
  "version": "1.0.0",
  "description": "微信步数修改工具 - 基于 Zepp Life 华米云端接口，可部署到 Vercel 或 Cloudflare",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:cf": "node scripts/build-pages.mjs && npx wrangler dev",
    "deploy:cf": "node scripts/build-pages.mjs && npx wrangler deploy"
  }
}
